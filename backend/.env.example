# =============================================
# DocLoq Backend — Environment Variables
# =============================================
# Copy this file to .env and fill in values.

# === Core ===
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# === Database (PostgreSQL via Docker) ===
DATABASE_URL=postgresql://user:password@localhost:5436/docloq_db

# === Authentication ===
JWT_SECRET=your-jwt-secret-change-in-production
HCAPTCHA_ENABLED=false
HCAPTCHA_SECRET=

# === OnlyOffice ===
BACKEND_URL=http://localhost:3000
BACKEND_URL_DOCKER=http://host.docker.internal:3000
ONLYOFFICE_URL=http://localhost:8082

# === Upload Processing ===
# Encryption master key — 64-char hex string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

# QR Code signing secret
QR_SIGNING_SECRET=your-qr-signing-secret
QR_VERIFICATION_BASE_URL=http://localhost:5173/verify

# === Malware Scanner ===
SCANNER_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# === Storage ===
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# Uncomment below for AWS S3 production:
# STORAGE_PROVIDER=s3
# AWS_REGION=ap-southeast-3
# AWS_S3_BUCKET=docloq-documents
# AWS_KMS_KEY_ARN=arn:aws:kms:ap-southeast-3:123456789012:key/...

# === Upload Limits ===
MAX_FILE_SIZE_MB=50

# === Email (Nodemailer) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@docloq.local
